# ==============================================================================
# AI LOOPING - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development or configure these variables
# in your Vercel Project Settings (Project -> Settings -> Environment Variables)
# ==============================================================================

# --- Application Core ---
APP_NAME="AI Looping"
APP_ENV=local
APP_KEY=base64:2nfpVIKE+sEbPKgIL+WQllp+PZGFXnDNOLBUUEvQoiM=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- Logging ---
# In local development, use 'stack'. On Vercel, set to 'stderr'.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (Aiven MySQL or Local XAMPP) ---
# For Local XAMPP:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=mail_sender
# DB_USERNAME=root
# DB_PASSWORD=
# DB_PREFIX=

# For Aiven MySQL Cloud (Production / Staging):
DB_CONNECTION=mysql
DB_HOST=mysql-xxxx-project.aivencloud.com
DB_PORT=25060
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password
# TABLE PREFIX: Keeps AI Looping tables (e.g. ailoop_users, ailoop_migrations) completely isolated
# from other applications sharing the same Aiven MySQL database.
DB_PREFIX=ailoop_
# Aiven SSL Configuration:
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false
MYSQL_ATTR_SSL_CA=

# --- Session & Cache Management ---
# In Vercel serverless environments, files cannot be saved to the read-only disk.
# Use 'database' or 'cookie' for sessions and 'database' for cache.
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Android APK Mobile Download (Optional) ---
# If hosting your compiled release APK on GitHub Releases, Cloudflare R2, or Google Drive,
# paste the public URL here to automatically redirect download requests.
# Leave empty to serve from public/app-debug.apk locally.
APK_DOWNLOAD_URL=

# --- Email Notifications & SMTP ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_gmail_address@gmail.com
MAIL_FROM_NAME="AI Looping"

# --- AI & Automation API Keys ---
# Groq AI
GROQ_API_KEY=
# Apollo Recruitment Sourcing
APOLLO_API_KEY=
# Google Gemini AI (Headhunter & Resume Tailoring)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- LinkedIn 1-Click OAuth Integration ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must match your LinkedIn App Developer Portal Authorized Redirect URI:
# Local: http://127.0.0.1:8000/auth/linkedin/callback
# Live:  https://your-app-domain.vercel.app/auth/linkedin/callback
LINKEDIN_REDIRECT_URI="http://127.0.0.1:8000/auth/linkedin/callback"

VITE_APP_NAME="${APP_NAME}"

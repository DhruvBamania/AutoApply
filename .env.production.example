# ==============================================================================
# VERCEL PRODUCTION ENVIRONMENT VARIABLES (.env.production.example)
# ==============================================================================
# In Vercel, navigate to: Project -> Settings -> Environment Variables
# Add the following key-value pairs for Production, Preview, and Development.
# ==============================================================================

# Core Application Settings
APP_NAME="AI Looping"
APP_ENV=production
APP_KEY=base64:2nfpVIKE+sEbPKgIL+WQllp+PZGFXnDNOLBUUEvQoiM=
APP_DEBUG=false
# Replace with your actual live Vercel domain or custom domain:
APP_URL=https://your-domain.vercel.app

# Serverless Logging (Required for Vercel Runtime Logs)
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Aiven MySQL Cloud Database Connection
DB_CONNECTION=mysql
DB_HOST=your-aiven-service-name.aivencloud.com
DB_PORT=your-aiven-port
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password
# Database Prefix: Keeps tables isolated from your 2 other apps sharing this database!
DB_PREFIX=ailoop_
# Disable server cert check if you do not have Aiven's ca.pem in the container
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# Serverless Storage & State Management
# (Vercel has a read-only filesystem, so use database for sessions and cache)
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
VIEW_COMPILED_PATH=/tmp/storage/framework/views

# Mobile APK Remote Link (Optional)
# If your APK exceeds GitHub or Vercel limits, host it on GitHub Releases or Drive:
# APK_DOWNLOAD_URL=https://github.com/your-username/your-repo/releases/download/v1.0.0/AI-Looping.apk

# Email SMTP Delivery
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_digit_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_gmail@gmail.com
MAIL_FROM_NAME="AI Looping"

# AI & Automation Services
GROQ_API_KEY=your_groq_api_key
APOLLO_API_KEY=your_apollo_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# LinkedIn OAuth Integration (Update with your live domain)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://your-domain.vercel.app/auth/linkedin/callback
